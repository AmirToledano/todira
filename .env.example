# Copy to .env for local docker-compose use. Never commit the real .env.

# Postgres
POSTGRES_USER=dorin
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=dorin
DATABASE_URL=postgresql+psycopg://dorin:change-me-locally@postgres:5432/dorin

# Telegram
TELEGRAM_BOT_TOKEN=get-this-from-BotFather

# Scraper
SCRAPE_CITIES=tel-aviv,ramat-gan,givatayim

# Manually-harvested Yad2 session cookie — see scraper/yad2_client.py's COOKIE_HEADER_ENV_VAR
# comment for exactly how to get this value (DevTools > Network tab > cookie request header,
# after solving the hCaptcha once yourself in a real browser). Needs periodic manual refresh.
# IMPORTANT: docker-compose treats "$" in .env values as variable interpolation (e.g. Google
# Analytics cookies commonly contain literal "$" characters) — escape every "$" as "$$" or that
# part of the cookie value gets silently stripped. Re-check this every time you re-harvest.
YAD2_COOKIE_HEADER=

# 2captcha.com API key — pays per-solve to get past Yad2's hCaptcha automatically. Get one at
# https://2captcha.com after adding a small balance. Leave blank to skip captcha-solving (the
# scraper will just log the challenge and move on, per scraper/YAD2_NOTES.md attempt #6).
TWOCAPTCHA_API_KEY=
