# Copy to .env for local docker-compose use. Never commit the real .env.

# Postgres
POSTGRES_USER=dorin
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=dorin
DATABASE_URL=postgresql+psycopg://dorin:change-me-locally@postgres:5432/dorin

# Telegram
TELEGRAM_BOT_TOKEN=get-this-from-BotFather

# Public website base URL (no trailing slash) — the bot links here (e.g. after saving a filter)
# so a user can see all their currently-matching listings, not just future ones. Defaults to the
# real production domain in bot/config.py if left unset.
WEBSITE_URL=https://todira.duckdns.org

# Gemini API key (free tier) — get one at https://aistudio.google.com/apikey. Used only as a
# fallback in bot onboarding when regex/keyword parsing can't understand a typo/abbreviation.
# Leave blank to skip — onboarding still works with plain regex parsing, just less forgiving.
GEMINI_API_KEY=

# Scraper — see scraper/yad2_client.py's CITY_SLUG_TO_ID for all slugs with a verified Yad2 city
# ID (all 42 of bot/cities.py's selectable cities, as of 2026-08-31 — every one is scraped in
# production too, see values.yaml's comment).
SCRAPE_CITIES=tel-aviv,ramat-gan,givatayim,jerusalem,haifa,beer-sheva,rishon-lezion,petah-tikva,ashdod,netanya,bnei-brak,holon,ashkelon,rehovot,bat-yam,beit-shemesh,kfar-saba,herzliya,hadera,raanana,nahariya,eilat,modiin,ramat-hasharon,ramla,nazareth,lod,hod-hasharon,kiryat-ata,kiryat-gat,kiryat-motzkin,kiryat-bialik,kiryat-ono,yavne,or-yehuda,tzfat,afula,tiberias,dimona,mevaseret-zion,har-gilo,karmiel

# ZenRows API key (free tier works) — get one at https://zenrows.com. Required for real Yad2
# scraping: patchright routes through ZenRows' residential proxy gateway to get past Yad2's
# Radware Bot Manager wall. See scraper/YAD2_NOTES.md and scraper/yad2_client.py for the full
# story. Without this set, the scraper CronJob just logs an error and finds 0 listings every run.
ZENROWS_API_KEY=
