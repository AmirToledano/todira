# Copy to .env for local docker-compose use. Never commit the real .env.

# Postgres
POSTGRES_USER=dorin
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=dorin
DATABASE_URL=postgresql+psycopg://dorin:change-me-locally@postgres:5432/dorin

# Telegram
TELEGRAM_BOT_TOKEN=get-this-from-BotFather

# Optional — your own numeric Telegram user ID (e.g. from @userinfobot). When set, the website's
# /contact form pushes each submission straight to this chat via the bot token above. Leave blank
# to skip — submissions are still saved to the contact_messages table either way.
OWNER_TELEGRAM_USER_ID=

# Signs the website's real-login session cookie (Telegram Login Widget, see website/main.py's
# /auth/telegram/callback). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Falls back to an insecure dev-only value if unset — fine for local dev, never for production.
SESSION_SECRET_KEY=

# Public website base URL (no trailing slash) — the bot links here (e.g. after saving a filter)
# so a user can see all their currently-matching listings, not just future ones. Defaults to the
# real production domain in bot/config.py if left unset. Also used as-is to build the Google
# OAuth redirect_uri below — must match a domain actually registered on the OAuth Client.
WEBSITE_URL=https://todira.duckdns.org

# Google Sign-In (website/main.py's /auth/google/start + /auth/google/callback) — from a Google
# Cloud OAuth Client (application type "Web application"); authorized redirect URI must be exactly
# ${WEBSITE_URL}/auth/google/callback. Both optional — the route 400s cleanly if unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini API key (free tier) — get one at https://aistudio.google.com/apikey. Used only as a
# fallback in bot onboarding when regex/keyword parsing can't understand a typo/abbreviation.
# Leave blank to skip — onboarding still works with plain regex parsing, just less forgiving.
GEMINI_API_KEY=

# Scraper: no per-city config needed anymore — scraper/main.py sweeps yad2_client.py's 7
# REGION_SLUGS every run (~6x cheaper than the old 42-city loop that used to be configured here via
# SCRAPE_CITIES/SCRAPE_CITIES_PER_RUN, see yad2_client.py's module docstring, 2026-09-03).

# ZenRows API key (free tier works) — get one at https://zenrows.com. Required for real Yad2
# scraping: ZenRows' Fetch API (js_render + premium_proxy) gets past Yad2's Radware Bot Manager
# wall and renders the page on their own infrastructure. See scraper/YAD2_NOTES.md and
# scraper/yad2_client.py for the full story. Without this set, the scraper CronJob just logs an
# error and finds 0 listings every run.
ZENROWS_API_KEY=

# The actual displayable WhatsApp number (E.164 digits, no leading '+') — builds the website's
# /account cross-channel-linking page's wa.me deep link. NOT the same as WHATSAPP_PHONE_NUMBER_ID
# (that's the Cloud API's internal id). Optional — /account just hides the WhatsApp linking
# option when unset.
WHATSAPP_PUBLIC_NUMBER=

# Real payment-gateway checkout via Grow/Meshulam (website/grow_client.py, 2026-09-05) — all three
# required together, from Grow support once the owner's business (עוסק פטור) is registered and a
# Grow account exists. Without them, /upgrade falls back to the earlier informal click-trust flow
# (a Bit transfer outside this system). GROW_SANDBOX defaults to "true" (Grow's sandbox endpoint)
# — see grow_client.py's module docstring before ever setting it to "false": this integration is
# NOT verified against Grow's own docs (this environment's network egress blocks every Grow/
# Meshulam docs domain), only against public references to their API shape.
GROW_PAGE_CODE=
GROW_USER_ID=
GROW_API_KEY=
GROW_SANDBOX=true

# Informal Bit/PayBox payment instructions on /upgrade/pay (2026-09-05) — used only while Grow
# isn't configured above. OWNER_BIT_PHONE: your own phone number, shown plainly for the customer
# to Bit-transfer to (no "open the app pre-filled" deep link exists for Bit — checked).
# OWNER_PAYBOX_URL: a PayBox payment link you generate yourself from the PayBox app, if you have
# one. Neither is secret; both optional — /upgrade/pay falls back to a generic hint when unset.
OWNER_BIT_PHONE=
OWNER_PAYBOX_URL=
